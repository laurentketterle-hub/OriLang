fold filter arr pred {
  hold result = []
  hold i = 0
  hold n = len arr
  loop i < n {
    hold elem = arr[i]
    when pred(elem) { push(result, elem) }
    hold i = i + 1
  }
  result
}

hold numbers = [1, 2, 3, 4, 5, 6]
fold even x { x % 2 == 0 }
hold evens = filter(numbers, even)
say ("filter: " + len evens + " evens")