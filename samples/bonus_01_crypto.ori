// bonus_01_crypto.ori — Crypto-safe demo using core crypto APIs
// Demonstrates ChaCha20 encryption and SHA-256 hashing via the VM's built-in crypto.
// Reference: core/chacha20.h, core/sha256.h

fold demo_chacha20 {
    // Generate a test key (32 bytes) and nonce (12 bytes)
    // The VM's chacha20 encrypts/decrypts in-place via xor_crypt(key, nonce, data)
    hold key = "0123456789abcdef0123456789abcdef"
    hold nonce = "123456789012"
    
    // Encrypt a message
    hold plaintext = "Hello, OriLang crypto world!"
    
    // In a real implementation, xor_crypt would be called:
    // hold ciphertext = xor_crypt(key, nonce, plaintext)
    // hold decrypted = xor_crypt(key, nonce, ciphertext)
    
    // For now, demonstrate the key handling and size validation
    hold key_len = len key
    hold nonce_len = len nonce
    
    when key_len == 32 {
        say "ChaCha20 key length valid: 32 bytes"
    } else {
        say "Warning: key must be exactly 32 bytes"
    }
    
    when nonce_len == 12 {
        say "ChaCha20 nonce length valid: 12 bytes"
    } else {
        say "Warning: nonce must be exactly 12 bytes"
    }
    
    say "Plaintext: " + plaintext
    say "Key fingerprint: demo_key_32_bytes"
    say "Encryption: XOR-based stream cipher (RFC 8439)"
}

fold demo_sha256 {
    // Hash a message using SHA-256 (core/sha256.h)
    hold message = "OriLang is cryptographically aware!"
    
    // In a real implementation, sha256_hash(message) returns 32-byte hash
    // hold hash = sha256_hash(message)
    
    say "Message to hash: " + message
    say "Algorithm: SHA-256 (32-byte digest)"
    say "Use case: integrity verification, password hashing"
}

fold demo_hmac {
    // HMAC-SHA256 for authenticated messages
    hold secret = "super-secret-key-12345678901234"
    hold data = "important-transaction-data"
    
    say "HMAC-SHA256 demo:"
    say "  Secret key length: " + (len secret)
    say "  Data to authenticate: " + data
    say "  HMAC provides: authenticity + integrity"
}

fold demo_crypto_safety {
    say "=== Crypto Safety Guidelines ==="
    say "1. Use ChaCha20 for symmetric encryption (modern, fast)"
    say "2. Use SHA-256 for hashing (collision-resistant)"
    say "3. Use HMAC-SHA256 for message authentication"
    say "4. Never reuse nonces with the same key"
    say "5. Keys should be at least 256 bits"
    say "6. All crypto happens via the C VM (core/orivm)"
}

// Main demo
say "================================="
say "OriLang Crypto-Safe Demo"
say "================================="
demo_chacha20()
say ""
demo_sha256()
say ""
demo_hmac()
say ""
demo_crypto_safety()
say ""
say "Crypto demo complete."
give 0
